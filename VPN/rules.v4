*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]

# Hairpin NAT: Redirect public IP HTTPS requests from VPN clients to local VPN gateway
-A PREROUTING -d 144.202.61.169 -p tcp --dport 443 -j DNAT --to-destination 10.2.0.1
-A POSTROUTING -s 10.2.0.0/24 -d 10.2.0.1 -p tcp --dport 443 -j MASQUERADE

# Outbound VPN NAT
-A POSTROUTING -s 10.2.0.0/24 -j MASQUERADE
-A POSTROUTING -o ppp+ -j MASQUERADE

COMMIT

*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# 1. Loopback and Established Connections
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# 2. Allow Packet Forwarding & Traffic for L2TP VPN Pool
-A FORWARD -s 10.2.0.0/24 -j ACCEPT
-A INPUT -i ppp+ -j ACCEPT

# 3. L2TP/IPsec VPN Inbound Ports (UDP 500, 4500, 1701)
-A INPUT -p udp --dport 500 -j ACCEPT
-A INPUT -p udp --dport 4500 -j ACCEPT
-A INPUT -p udp --dport 1701 -j ACCEPT

# 4. Trusted Sources
-A INPUT -s xx.xx.xx.xx -j ACCEPT

# 6. Private Subnets
-A INPUT -s 10.0.0.0/8 -j ACCEPT
-A INPUT -s 172.16.0.0/12 -j ACCEPT
-A INPUT -s 192.168.0.0/16 -j ACCEPT

COMMIT
