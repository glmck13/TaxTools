{
  "template": {
    "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "logicAppName": {
        "type": "String",
        "metadata": {
          "description": "Name of the logic app."
        }
      },
      "logicAppLocation": {
        "defaultValue": "[resourceGroup().location]",
        "allowedValues": [
          "eastasia",
          "southeastasia",
          "centralus",
          "eastus",
          "eastus2",
          "westus",
          "northcentralus",
          "southcentralus",
          "northeurope",
          "westeurope",
          "japanwest",
          "japaneast",
          "brazilsouth",
          "australiaeast",
          "australiasoutheast",
          "southindia",
          "centralindia",
          "westindia",
          "canadacentral",
          "canadaeast",
          "uaecentral",
          "westcentralus",
          "westus2",
          "[resourceGroup().location]"
        ],
        "type": "String",
        "metadata": {
          "description": "Location of the logic app."
        }
      },
      "sharepointonline_Connection_Name": {
        "defaultValue": "sharepointonline",
        "type": "String",
        "metadata": {
          "description": "Name of the connection."
        }
      }
    },
    "resources": [
      {
        "type": "Microsoft.Logic/workflows",
        "apiVersion": "2016-06-01",
        "name": "[parameters('logicAppName')]",
        "location": "[parameters('logicAppLocation')]",
        "dependsOn": [
          "[resourceId('Microsoft.Web/connections', parameters('sharepointonline_Connection_Name'))]"
        ],
        "properties": {
          "state": "Disabled",
          "definition": {
            "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
            "contentVersion": "undefined",
            "parameters": {
              "$authentication": {
                "defaultValue": {},
                "type": "SecureObject"
              },
              "$connections": {
                "defaultValue": {},
                "type": "Object"
              }
            },
            "triggers": {
              "manual": {
                "metadata": {
                  "operationMetadataId": "724a23e6-f884-43c5-8371-cc57ffb82431"
                },
                "type": "Request",
                "kind": "Button",
                "inputs": {
                  "schema": {
                    "type": "object",
                    "properties": {},
                    "required": []
                  }
                }
              }
            },
            "actions": {
              "List_Documents": {
                "runAfter": {},
                "metadata": {
                  "flowSystemMetadata": {
                    "portalOperationIconOverride": "https://conn-afd-prod-endpoint-bmc9bqahasf3grgk.b01.azurefd.net/v1.0.1769/1.0.1769.4352/sharepointonline/icon.png",
                    "portalOperationBrandColorOverride": "",
                    "portalOperationId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline/apiOperations/GetFileItems"
                  },
                  "operationMetadataId": "94188f95-20ba-4229-8e0e-a4d8be4a8c0f"
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "dataset": "https://tarrantadvisors.sharepoint.com",
                    "table": "8b07e830-ff9f-475e-a3c0-a4244dc18ccb",
                    "viewScopeOption": "Default"
                  },
                  "host": {
                    "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                    "connectionReferenceName": "shared_sharepointonline",
                    "operationId": "GetFileItems"
                  }
                },
                "runtimeConfiguration": {
                  "paginationPolicy": {
                    "minimumItemCount": 1000
                  }
                }
              },
              "Count_Files": {
                "foreach": "@body('Select_folders')",
                "actions": {
                  "Get_files_(properties_only)_-_count": {
                    "metadata": {
                      "operationMetadataId": "760e0738-f0dd-4d01-bb7d-08a73bc23c05"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://tarrantadvisors.sharepoint.com",
                        "table": "8b07e830-ff9f-475e-a3c0-a4244dc18ccb",
                        "folderPath": "@item()?['{FullPath}']",
                        "viewScopeOption": "RecursiveAll"
                      },
                      "host": {
                        "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                        "connectionReferenceName": "shared_sharepointonline",
                        "operationId": "GetFileItems"
                      }
                    }
                  },
                  "Get_folder_metadata_-_count": {
                    "runAfter": {
                      "Get_files_(properties_only)_-_count": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "b52f4e58-a627-445e-8b11-31e50e533e1c"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://tarrantadvisors.sharepoint.com",
                        "id": "@item()?['{FullPath}']"
                      },
                      "host": {
                        "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                        "connectionReferenceName": "shared_sharepointonline",
                        "operationId": "GetFolderMetadata"
                      }
                    }
                  },
                  "Update_Properties": {
                    "runAfter": {
                      "Get_logfile_properties": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "7275cea6-8735-4952-ac6d-59fe84ca2a6d"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://tarrantadvisors.sharepoint.com",
                        "table": "8b07e830-ff9f-475e-a3c0-a4244dc18ccb",
                        "id": "@outputs('Get_folder_metadata_-_count')?['body/ItemId']",
                        "item/TotalFiles": "@length(body('Select_files_only'))",
                        "item/Format/Value": "Electronic",
                        "item/RetLoaded/Value": "No",
                        "item/ClientLog": "@outputs('Get_logfile_properties')?['body/{Link}']"
                      },
                      "host": {
                        "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                        "connectionReferenceName": "shared_sharepointonline",
                        "operationId": "PatchFileItem"
                      }
                    }
                  },
                  "Select_files_only": {
                    "runAfter": {
                      "Get_folder_metadata_-_count": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "38652418-16bb-4f20-82be-025f006b3b48"
                    },
                    "type": "Query",
                    "inputs": {
                      "from": "@outputs('Get_files_(properties_only)_-_count')?['body/value']",
                      "where": "@equals(item()?['{IsFolder}'],false)"
                    }
                  },
                  "Get_logfile_properties": {
                    "runAfter": {
                      "Create_logfile": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "37fac0cd-c6fe-4150-ae95-95226a8369e6"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://tarrantadvisors.sharepoint.com",
                        "table": "8b07e830-ff9f-475e-a3c0-a4244dc18ccb",
                        "id": "@outputs('Create_logfile')?['body/ItemId']"
                      },
                      "host": {
                        "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                        "connectionReferenceName": "shared_sharepointonline",
                        "operationId": "GetFileItem"
                      }
                    }
                  },
                  "Get_logfile_template": {
                    "runAfter": {
                      "Select_files_only": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "%252fShared%2bDocuments%252fClient%2bLog%2bTemplate.xlsx": "/Shared Documents/Client Log Template.xlsx",
                      "operationMetadataId": "4dc3b4a5-a2ac-496c-99f5-29a6491059f2"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://tarrantadvisors.sharepoint.com",
                        "id": "%252fShared%2bDocuments%252fClient%2bLog%2bTemplate.xlsx",
                        "inferContentType": true
                      },
                      "host": {
                        "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                        "connectionReferenceName": "shared_sharepointonline",
                        "operationId": "GetFileContent"
                      }
                    }
                  },
                  "Create_logfile": {
                    "runAfter": {
                      "Get_logfile_template": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "bfb9f648-91d0-464a-9b51-bff6476ccefd"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://tarrantadvisors.sharepoint.com",
                        "folderPath": "@replace(item()?['{FullPath}'], ' - SHARED', '')",
                        "name": "Log-@{join(take(split(replace(item()?['{Name}'], ' - SHARED', ''),' '),3),'')}.xlsx",
                        "body": "@body('Get_logfile_template')"
                      },
                      "host": {
                        "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                        "connectionReferenceName": "shared_sharepointonline",
                        "operationId": "CreateFile"
                      }
                    }
                  }
