                        "connectionReferenceName": "shared_sharepointonline",
                        "operationId": "GetFileItems"
                      }
                    }
                  },
                  "Get_folder_metadata_-_search": {
                    "runAfter": {
                      "Filter_array": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "aa32a956-060f-48b7-b07b-73932cc6df13"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://tarrantadvisors.sharepoint.com",
                        "id": "@item()?['{FullPath}']"
                      },
                      "host": {
                        "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                        "connectionReferenceName": "shared_sharepointonline",
                        "operationId": "GetFolderMetadata"
                      }
                    }
                  },
                  "Update_Questionnaire": {
                    "runAfter": {
                      "Get_folder_metadata_-_search": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "e5b85b52-f8a1-4d95-83f1-e0c28888e684"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://tarrantadvisors.sharepoint.com",
                        "table": "8b07e830-ff9f-475e-a3c0-a4244dc18ccb",
                        "id": "@outputs('Get_folder_metadata_-_search')?['body/ItemId']",
                        "item/Questionnaire/Value": "@if(greater(length(body('Filter_array')), 0), 'Submitted', 'Not Found')"
                      },
                      "host": {
                        "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                        "connectionReferenceName": "shared_sharepointonline",
                        "operationId": "PatchFileItem"
                      }
                    }
                  },
                  "Filter_array": {
                    "runAfter": {
                      "Get_files_(properties_only)_-_search": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "f31d15bf-61f9-4855-9b5d-188675621b11"
                    },
                    "type": "Query",
                    "inputs": {
                      "from": "@outputs('Get_files_(properties_only)_-_search')?['body/value']",
                      "where": "@contains(item()?['{FilenameWithExtension}'],'Questionnaire.pdf')"
                    }
                  }
                },
                "runAfter": {
                  "Count_Files": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "26f644d5-89c8-4450-9fd2-aa7a8822738e"
                },
                "type": "Foreach"
              },
              "Select_folders": {
                "runAfter": {
                  "Select_SHARED": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "6fbf814a-248e-4f3a-a327-45373d8ea2df"
                },
                "type": "Query",
                "inputs": {
                  "from": "@body('Select_SHARED')",
                  "where": "@equals(item()?['{IsFolder}'],true)"
                }
              },
              "Select_SHARED": {
                "runAfter": {
                  "List_Documents": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "5057f339-8704-43b1-a3df-34b7bbaf3ae0"
                },
                "type": "Query",
                "inputs": {
                  "from": "@outputs('List_Documents')?['body/value']",
                  "where": "@endsWith(item()?['{FullPath}'],' - SHARED')"
                }
              }
            }
          },
