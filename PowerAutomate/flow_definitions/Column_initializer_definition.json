    "contentVersion": "1.0.0.0",
    "parameters": {
      "logicAppName": {
        "type": "String",
        "metadata": {
          "description": "Name of the logic app."
        }
      },
      "logicAppLocation": {
        "defaultValue": "[resourceGroup().location]",
        "allowedValues": [
          "eastasia",
          "southeastasia",
          "centralus",
          "eastus",
          "eastus2",
          "westus",
          "northcentralus",
          "southcentralus",
          "northeurope",
          "westeurope",
          "japanwest",
          "japaneast",
          "brazilsouth",
          "australiaeast",
          "australiasoutheast",
          "southindia",
          "centralindia",
          "westindia",
          "canadacentral",
          "canadaeast",
          "uaecentral",
          "westcentralus",
          "westus2",
          "[resourceGroup().location]"
        ],
        "type": "String",
        "metadata": {
          "description": "Location of the logic app."
        }
      },
      "sharepointonline_Connection_Name": {
        "defaultValue": "sharepointonline",
        "type": "String",
        "metadata": {
          "description": "Name of the connection."
        }
      }
    },
    "resources": [
      {
        "type": "Microsoft.Logic/workflows",
        "apiVersion": "2016-06-01",
        "name": "[parameters('logicAppName')]",
        "location": "[parameters('logicAppLocation')]",
        "dependsOn": [
          "[resourceId('Microsoft.Web/connections', parameters('sharepointonline_Connection_Name'))]"
        ],
        "properties": {
          "state": "Disabled",
          "definition": {
            "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
            "contentVersion": "undefined",
            "parameters": {
              "$authentication": {
                "defaultValue": {},
                "type": "SecureObject"
              },
              "$connections": {
                "defaultValue": {},
                "type": "Object"
              }
            },
            "triggers": {
              "manual": {
                "metadata": {
                  "operationMetadataId": "373f7c72-5684-44a9-9852-4d0477592ec3"
                },
                "type": "Request",
                "kind": "Button",
                "inputs": {
                  "schema": {
                    "type": "object",
                    "properties": {},
                    "required": []
                  }
                }
              }
            },
            "actions": {
              "List_Documents": {
                "runAfter": {},
                "metadata": {
                  "flowSystemMetadata": {
                    "portalOperationIconOverride": "https://conn-afd-prod-endpoint-bmc9bqahasf3grgk.b01.azurefd.net/v1.0.1769/1.0.1769.4352/sharepointonline/icon.png",
                    "portalOperationBrandColorOverride": "",
                    "portalOperationId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline/apiOperations/GetFileItems"
                  },
                  "operationMetadataId": "f04ed3ee-4bb2-49af-aa05-d3b0b8c25a7a"
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "dataset": "https://tarrantadvisors.sharepoint.com/sites/TarrantAdvisorsShare",
                    "table": "26639a91-d6e9-4a4a-9fa3-e3797c13d5b6",
                    "viewScopeOption": "Default"
                  },
                  "host": {
                    "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                    "connectionReferenceName": "shared_sharepointonline",
                    "operationId": "GetFileItems"
                  }
                },
                "runtimeConfiguration": {
                  "paginationPolicy": {
                    "minimumItemCount": 1000
                  }
                }
              },
              "Count_Files": {
                "foreach": "@body('Select_folders')",
                "actions": {
                  "Get_files_(properties_only)_-_count": {
                    "metadata": {
                      "operationMetadataId": "bd85f265-5d78-44ff-b6b7-db7ebb2c1b6e"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://tarrantadvisors.sharepoint.com/sites/TarrantAdvisorsShare",
                        "table": "26639a91-d6e9-4a4a-9fa3-e3797c13d5b6",
                        "folderPath": "@item()?['{FullPath}']",
                        "viewScopeOption": "RecursiveAll"
                      },
                      "host": {
                        "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                        "connectionReferenceName": "shared_sharepointonline",
                        "operationId": "GetFileItems"
                      }
                    },
                    "runtimeConfiguration": {
                      "paginationPolicy": {
                        "minimumItemCount": 1000
                      }
                    }
                  },
                  "Get_folder_metadata_-_count": {
                    "runAfter": {
                      "Get_files_(properties_only)_-_count": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "808a8f88-1a75-401c-b83b-16c6ffd4689a"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://tarrantadvisors.sharepoint.com/sites/TarrantAdvisorsShare",
                        "id": "@item()?['{FullPath}']"
                      },
                      "host": {
                        "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                        "connectionReferenceName": "shared_sharepointonline",
                        "operationId": "GetFolderMetadata"
                      }
                    }
                  },
                  "Update_Properties": {
                    "runAfter": {
                      "Get_logfile_properties": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "0c774c72-2504-4a20-ad59-0ce439d06c81"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://tarrantadvisors.sharepoint.com/sites/TarrantAdvisorsShare",
                        "table": "26639a91-d6e9-4a4a-9fa3-e3797c13d5b6",
                        "id": "@outputs('Get_folder_metadata_-_count')?['body/ItemId']",
                        "item/TotalFiles": "@length(body('Select_files_only'))",
                        "item/Format/Value": "Electronic",
                        "item/RetLoaded/Value": "No",
                        "item/ClientLog": "@outputs('Get_logfile_properties')?['body/{Link}']"
                      },
                      "host": {
                        "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                        "connectionReferenceName": "shared_sharepointonline",
                        "operationId": "PatchFileItem"
                      }
                    }
                  },
                  "Select_files_only": {
                    "runAfter": {
                      "Get_folder_metadata_-_count": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "ff0524c9-0ca3-4d30-9f08-fb2acf5df111"
                    },
                    "type": "Query",
                    "inputs": {
                      "from": "@outputs('Get_files_(properties_only)_-_count')?['body/value']",
                      "where": "@equals(item()?['{IsFolder}'],false)"
                    }
                  },
                  "Get_logfile_properties": {
                    "runAfter": {
                      "Create_logfile": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "92e87e8d-4678-43d7-8c31-a9851446b219"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://tarrantadvisors.sharepoint.com/sites/Company",
                        "table": "cf46e4f0-8fc3-46cb-8a99-142613b2147b",
                        "id": "@outputs('Create_logfile')?['body/ItemId']"
                      },
                      "host": {
                        "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                        "connectionReferenceName": "shared_sharepointonline",
                        "operationId": "GetFileItem"
                      }
                    }
                  },
                  "Get_logfile_template": {
                    "runAfter": {
                      "Select_files_only": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "%252fShared%2bDocuments%252fClient%2bLog%2bTemplate.xlsx": "/Shared Documents/Client Log Template.xlsx",
                      "operationMetadataId": "3bb65caa-959f-451d-81c2-172dbecf86f7"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://tarrantadvisors.sharepoint.com/sites/TarrantAdvisorsShare",
                        "id": "%252fShared%2bDocuments%252fClient%2bLog%2bTemplate.xlsx",
                        "inferContentType": true
                      },
                      "host": {
                        "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                        "connectionReferenceName": "shared_sharepointonline",
                        "operationId": "GetFileContent"
                      }
                    }
                  },
