                    "metadata": {
                      "operationMetadataId": "f5ba0172-0f7e-4d83-a5e1-250e72c07d79"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://tarrantadvisors.sharepoint.com/sites/Company",
                        "folderPath": "@replace(item()?['{FullPath}'], ' - SHARED', '')",
                        "name": "Log-@{join(take(split(replace(item()?['{Name}'], ' - SHARED', ''),' '),3),'')}.xlsx",
