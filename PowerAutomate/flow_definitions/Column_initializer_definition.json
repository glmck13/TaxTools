                    "metadata": {
                      "operationMetadataId": "99d678c6-6980-4e8a-ab26-24967fe142c0"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "https://tarrantadvisors.sharepoint.com/sites/TarrantAdvisorsShare",
                        "table": "26639a91-d6e9-4a4a-9fa3-e3797c13d5b6",
                        "id": "@outputs('Get_folder_metadata_-_search')?['body/ItemId']",
                        "item/Questionnaire/Value": "@if(greater(length(body('Filter_array')), 0), 'Submitted', 'Not Found')"
                      },
                      "host": {
                        "apiId": "subscriptions/default-fb5857de-616e-45bd-b841-8ba900665fd5/providers/Microsoft.Web/locations/westus/runtimes/unitedstates-002/apis/sharepointonline",
                        "connectionReferenceName": "shared_sharepointonline",
                        "operationId": "PatchFileItem"
                      }
                    }
                  },
                  "Filter_array": {
                    "runAfter": {
                      "Get_files_(properties_only)_-_search": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "686cbfae-43ed-42b0-8f97-aa206a07918a"
                    },
                    "type": "Query",
                    "inputs": {
                      "from": "@outputs('Get_files_(properties_only)_-_search')?['body/value']",
                      "where": "@contains(item()?['{FilenameWithExtension}'],'Questionnaire.pdf')"
                    }
                  }
                },
                "runAfter": {
                  "Count_Files": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "d2c5bd1e-fb4b-446c-ae27-f90c9e2760d1"
                },
                "type": "Foreach"
              },
              "Select_folders": {
                "runAfter": {
                  "Select_SHARED": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "1d1f9122-0bb8-4ac4-9ea1-7fb63f313e08"
                },
                "type": "Query",
                "inputs": {
                  "from": "@body('Select_SHARED')",
                  "where": "@equals(item()?['{IsFolder}'],true)"
                }
              },
              "Select_SHARED": {
                "runAfter": {
                  "List_Documents": [
                    "Succeeded"
                  ]
                },
                "metadata": {
                  "operationMetadataId": "4f7277d0-df24-4e5a-b539-d4c1594f9c52"
                },
                "type": "Query",
                "inputs": {
                  "from": "@outputs('List_Documents')?['body/value']",
                  "where": "@endsWith(item()?['{FullPath}'],' - SHARED')"
                }
              }
            },
